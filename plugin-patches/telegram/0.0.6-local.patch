+// LOCAL PATCH (newcomer welcome): Telegram delivers a group join as a
+// service message carrying ctx.message.new_chat_members. The base plugin only wires
+// content subtypes (text/photo/...), so joins were silently dropped and Claude never
+// saw them. Surface human joins so Claude can post the welcome — the welcome copy
+// lives in Claude's memory (memory/channels/<chat>/newcomer-welcome.md), not
+// hardcoded here, so it stays editable without re-patching the plugin. Bots are
+// filtered out, including this bot being added to a new group. Routed through
+// handleInbound so the same gate()/sanitize/deliver path applies: only groups
+// configured chatty (requireMention=false) actually greet; mention-gated groups
+// drop the join, which is the desired behavior there.
+// NOTE: lives in the versioned plugin cache — lost on plugin update; tracked in
+// <repo>/plugin-patches/telegram/.
+// DISABLED by default: greeting every join means a wave of spam
+// registrations becomes a wave of welcomes from us — i.e. the bot becomes the spam it
+// cleans up (a chat admin caught this the evening it shipped). Re-enable by
+// flipping this to true once the trigger moves to "newcomer's first message" or gains a
+// rate limit. Handler kept intact so re-enabling is a one-line change.
+const WELCOME_ON_JOIN = false
+
+bot.on('message:new_chat_members', async ctx => {
+  if (!WELCOME_ON_JOIN) return
+  const humans = ctx.message.new_chat_members.filter(u => !u.is_bot)
+  if (humans.length === 0) return
+  const names = humans
+    .map(u => safeName([u.first_name, u.last_name].filter(Boolean).join(' ')) || String(u.id))
+    .join(', ')
+  await handleInbound(ctx, `(new_chat_members: ${names})`, undefined)
+})
