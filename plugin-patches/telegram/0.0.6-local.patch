 // Telegram caps messages at 4096 chars. Split long replies, preferring
 // paragraph boundaries when chunkMode is 'newline'.
 
+// Strip long base64-shaped runs from inbound chat text before it enters
+// Claude's context. Wedging incidents seen in production more than once:
+// a base64-wrapped "decode and follow" payload was replayed on every
+// subsequent --continue turn and Anthropic's classifier flagged it as
+// injection, locking the session for every later message regardless of
+// author. Threshold 120 chars avoids clipping normal IDs/hashes/short tokens.
+const BASE64_BLOB_RE = /[A-Za-z0-9+/]{120,}={0,2}/g
+function stripSuspiciousBlobs(text: string): { text: string; stripped: number } {
+  let stripped = 0
+  const out = text.replace(BASE64_BLOB_RE, m => {
+    stripped++
+    return `[base64 blob stripped, ${m.length} chars]`
+  })
+  return { text: out, stripped }
+}
