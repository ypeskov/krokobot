# Bot configuration. Copy to bot.env (gitignored) and fill in your values.
# Every script and hook reads this file; nothing else carries chat ids or paths.
#
# Shell scripts source it via bot-env.sh, Python hooks import botconfig.py.
# Values are plain KEY=VALUE, no quotes needed unless the value has spaces.

# Where chat logs, recall bundles and guard state live. Keep it OUTSIDE the repo
# and outside ~/.claude: the harness treats paths under .claude/ as sensitive and a
# headless `claude -p` run cannot write there.
BOT_LOG_ROOT=~/bot-logs

# Telegram chat id of the operator's private chat with the bot. Guards send their
# alerts here ("auto-compact fired", "chat log writer is dead"). Leave empty to
# disable alerts.
BOT_OWNER_CHAT_ID=

# Chat id -> log directory name. Semicolon separated. Unknown chats are logged as
# chat_<id>. The directory name is what the recall chronicle shows as the chat title,
# and memory/channels/<name>/ is where that chat's tone rules live.
# Group ids are negative and start with -100.
BOT_CHATS=-1001234567890=yacht-chat;-1009876543210=car-chat;123456789=dm-owner

# Chats where the bot holds admin rights and tg-mod.sh may delete/ban. Semicolon
# separated. A chat not listed here is refused, so a typo fails loudly.
BOT_MOD_CHATS=-1009876543210

# Timezone used for [HH:MM] stamps in the chat log and in the recall chronicle.
# The server itself is expected to run in UTC.
BOT_TZ=Europe/Sofia

# tmux session name the launcher and watchdog use.
BOT_TMUX_SESSION=claude

# Model passed to `claude --model`. Pinned explicitly so `--continue` cannot restore
# whatever model the previous session stored.
BOT_MODEL=opus[1m]

# Telegram plugin state dir (token .env, access.json, approved/, inbox/). The
# launcher exports it as TELEGRAM_STATE_DIR so the bot carries its own state
# instead of the machine-global ~/.claude/channels/telegram. Default: project-local.
# BOT_TELEGRAM_STATE_DIR=~/krokobot/.claude/channels/telegram

# Claude Code project dir holding the session transcripts (*.jsonl). Guards tail the
# newest transcript there. Default is derived from the repo path the same way Claude
# Code derives it: ~/.claude/projects/<repo path with / replaced by ->.
# BOT_PROJECT_DIR=
